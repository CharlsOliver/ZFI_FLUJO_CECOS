<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">
    <Dialog
        id="dAgregarRegistro"
        title="Agregar registro"
        contentWidth="650px">
        <content>
            <VBox>
                <f:SimpleForm
                    editable="true"
                    layout="ResponsiveGridLayout"
                    title="Datos básicos"
                    labelSpanXL="3"
                    labelSpanL="3"
                    labelSpanM="3"
                    labelSpanS="12"
                    adjustLabelSpan="false"
                    emptySpanXL="4"
                    emptySpanL="4"
                    emptySpanM="4"
                    emptySpanS="0"
                    columnsXL="1"
                    columnsL="1"
                    columnsM="1"
                    singleContainerFullSize="false">
                    <f:content>
                        <Label text="Centro de costo" id="lblInputCeco" />
                        <Input id="inptCeco" type="Number"/>

                        <Label text="Centro de costo" id="lblCboxCeco" />
                        <Input
                            id="cboxCeco"
                            type="Text"
                            showValueHelp="true"
                            valueHelpOnly="true"
                            valueHelpRequest=".openCentroHelpRequest" />

                        <Label text="Descripción" />
                        <Input id="inptDescripcion"/>

                        <Label text="Usuario" />
                        <Input
                            id="cboxUsuario"
                            type="Text"
                            showValueHelp="true"
                            valueHelpOnly="true"
                            valueHelpRequest=".openCatalogHelpRequest">
                            <customData>
                                <core:CustomData key="vhCampoId" value="5" />
                            </customData>
                        </Input>

                        <Label text="Responsable" />
                        <Input
                            id="cboxResponsable"
                            type="Text"
                            showValueHelp="true"
                            valueHelpOnly="true"
                            valueHelpRequest=".openCatalogHelpRequest">
                            <customData>
                                <core:CustomData key="vhCampoId" value="5" />
                            </customData>
                        </Input>

                        <Label text="Departamento" />
                        <Input id="inptDepartamento"  />

                        <Label text="Clase CeCo" />
                        <ComboBox showSecondaryValues= "true" filterSecondaryValues= "true" id="cboxClase" items="{ path: 'Clase>/' }">
                            <core:ListItem key="{Clase>Valor}" text="{Clase>Descripcion}" additionalText="{Clase>Valor}"/>
                        </ComboBox>

                        <Label text="Area jerarquica" />
                        <Input
                            id="cboxAreaJerarquica"
                            type="Text"
                            showValueHelp="true"
                            valueHelpOnly="true"
                            valueHelpRequest=".openCatalogHelpRequest">
                            <customData>
                                <core:CustomData key="vhCampoId" value="7" />
                            </customData>
                        </Input>

                        <Label text="Sociedad" />
                        <Input
                            id="cboxSociedad"
                            type="Text"
                            showValueHelp="true"
                            valueHelpOnly="true"
                            valueHelpRequest=".openCatalogHelpRequest" >
                            <customData>
                                <core:CustomData key="vhCampoId" value="8" />
                            </customData>
                        </Input>

                        <Label text="Area funcional" />
                        <ComboBox showSecondaryValues= "true" filterSecondaryValues= "true" id="cboxAreaFuncional" items="{ path: 'AreaFuncional>/' }">
                            <core:ListItem key="{AreaFuncional>Valor}" text="{AreaFuncional>Descripcion}" additionalText="{AreaFuncional>Valor}"/>
                        </ComboBox>

                        <Label text="Moneda" />
                        <ComboBox showSecondaryValues= "true" filterSecondaryValues= "true" id="cboxMoneda" items="{ path: 'Moneda>/' }">
                            <core:ListItem key="{Moneda>Valor}" text="{Moneda>Descripcion}" additionalText="{Moneda>Valor}"/>
                        </ComboBox>

                        <Label text="Centro de Beneficio" />
                        <Input
                            id="cboxCentroBeneficio"
                            type="Text"
                            showValueHelp="true"
                            valueHelpOnly="true"
                            valueHelpRequest=".openCatalogHelpRequest" >
                            <customData>
                                <core:CustomData key="vhCampoId" value="12" />
                            </customData>
                        </Input>

                    </f:content>
                </f:SimpleForm>
            </VBox>
        </content>
        <buttons>
            <Button id="btnAceptar" type="Accept" text="Agregar" press="onAgregarRegistro" />
            <Button id="btnCerrarDialog" text="Cerrar" press="onCerrarAgregarRegistro" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>