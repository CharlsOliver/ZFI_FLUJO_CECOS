<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified">
    <Dialog
        id="dCargaExcelFragment"
        title="Cargar desde Excel">
        <content>
            <VBox alignItems="Center" 
                justifyContent="Center"
                width="100%">
                <u:FileUploader
                    id="fileUploader"
                    width="100%"
                    class="sapUiTinyMarginTop"
                    fileType="xlsx,xls"
                    tooltip="Cargar registros desde archivo excel."
                    uploadOnChange="false"
                    useMultipart="false"
                    change="onFileSelected"/>
            </VBox>
        </content>
        <buttons>
            <Button id="btnCargar" type="Accept" text="Cargar archivo" press="onCargar" />
            <Button id="btnCerrarDialogCarga" text="Cerrar" press="onCloseCargarExcel" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
